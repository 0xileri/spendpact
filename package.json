{
  "name": "spact",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contracts:build": "scripts/build-contracts.sh",
    "contracts:test": "scripts/test-contracts.sh",
    "e2e": "pnpm --filter @spact/web e2e",
    "mcp:sandbox": "pnpm --filter @spact/mcp test:sandbox",
    "notifier:sandbox": "pnpm --filter @spact/notifier test:sandbox",
    "dev:sandbox": "scripts/dev-sandbox.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
