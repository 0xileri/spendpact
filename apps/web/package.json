  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "near-api-js": "7.2.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
